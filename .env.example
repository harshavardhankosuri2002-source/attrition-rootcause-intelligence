# RetentionIQ Environment Configuration
# Copy this file to .env and configure for your deployment

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional External LLM Integration
# If not provided, the application automatically uses the local grounded analytics engine
# with 100% zero-hallucination mathematical execution on the active dataset.
GEMINI_API_KEY=

# Security & Governance
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:8000"]
SESSION_SECRET_KEY=change_this_to_a_secure_random_string_in_production
MAX_UPLOAD_SIZE_MB=15
